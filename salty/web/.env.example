# Copy to .env.local for local work, and set the same names in your host's settings for the live site.
# Everything here is public (it ends up in the browser), so no secrets belong in this file.

# The live address, no trailing slash. Used for share links, the sitemap and link previews.
NEXT_PUBLIC_SITE_URL=https://example.com

# Where every email sign-up is posted. Any form endpoint that accepts a standard form POST works.
# Fields sent: email, interest (newsletter, raise-plan, offer, employer, country-au ...), country,
# job, source. Pay is never sent. Until this is set, forms say sign-ups are not switched on.
NEXT_PUBLIC_WAITLIST_URL=

# AI estimates. With this empty the site still shows its built-in estimates (common jobs in ten
# countries), which cost nothing and need no key. Set it to add a live AI for every other job and
# country: on a host that runs functions/api/estimate.ts (Cloudflare Pages does, automatically)
# set it to /api/estimate, and set ANTHROPIC_API_KEY as a SECRET in the host's settings, never here.
# Host settings, all optional:
#   SALTY_ESTIMATE_SEARCH=on   search the web first. Better and more current, and much dearer.
#                              Left unset, the AI answers from general knowledge: a small
#                              fraction of a cent per new job looked up.
#   SALTY_ESTIMATE_MODEL=...   a different Claude model from the default for the chosen mode.
NEXT_PUBLIC_ESTIMATE_URL=

# Selling the full raise plan. Leave all three empty to collect interest instead of taking payment.
# CHECKOUT_URL: a payment link from your payment provider (opens in a new tab).
# PRICE: shown on the button, for example £4.99.
# CODE: the unlock code your payment provider shows or emails after payment.
# This is a soft lock: the code is the same for every buyer and a determined person could find it.
# It is fine for testing whether people will pay; a real lock needs accounts on a server.
NEXT_PUBLIC_PLAN_CHECKOUT_URL=
NEXT_PUBLIC_PLAN_PRICE=
NEXT_PUBLIC_PLAN_CODE=

# Optional: cookieless visit and event counts (Umami). Leave empty for no analytics at all.
NEXT_PUBLIC_UMAMI_ID=
# NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js

# Optional: the "built in public" block appears once at least one link is set.
NEXT_PUBLIC_FOUNDER_NAME=
NEXT_PUBLIC_FOUNDER_TIKTOK=
NEXT_PUBLIC_FOUNDER_INSTAGRAM=
NEXT_PUBLIC_FOUNDER_YOUTUBE=
NEXT_PUBLIC_FOUNDER_X=

# Optional: shown on the privacy page as the address for deletion requests.
NEXT_PUBLIC_CONTACT_EMAIL=
